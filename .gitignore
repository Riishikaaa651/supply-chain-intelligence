# Virtual environment
venv/

# Environment variables and secrets
.env
.streamlit/secrets.toml

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Jupyter checkpoints
.ipynb_checkpoints/
notebooks/*_executed.ipynb

# Data files (raw data usually large/private)
data/raw/*
!data/raw/.gitkeep

# Processed datasets (large files)
data/processed/

# Database
*.db

# Trained models (usually large files)
models/*.pkl
models/*.joblib

# Logs
logs/*.log

# OS files
.DS_Store
Thumbs.db

# VS Code settings (optional)
.vscode/

# Database (only the slim deploy copy is committed)
*.db
!data/supply_chain_deploy.db